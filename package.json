{
  "name": "focoman-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "NODE_ENV=production npm --prefix apps/web run build",
    "test": "node --experimental-strip-types --test tests/backend-crud.test.ts",
    "start": "npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint",
    "gitpush": "powershell -ExecutionPolicy Bypass -File scripts/gitpush.ps1",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
