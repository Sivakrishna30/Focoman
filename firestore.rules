rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All application data access is mediated by the server-only Admin SDK.
    // Admin SDK requests bypass these rules; role checks must be enforced by server code.
    // Keep direct browser SDK reads and writes denied for every collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
